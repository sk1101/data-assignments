  "datasets": [
    {
      "name": "lake.cdc_changes",
      "layer": "lake",
      "description": "Every change captured from the source, append-only (raw layer). One row per change in lsn order; before/after are JSON images of the row.",
      "location": "data/lake/changes/*.parquet",
      "format": "parquet",
      "owner": "data-platform",
      "intended_consumers": [
        "data engineers (replay, rebuild, debugging)",
        "auditors"
      ],
      "update_cadence": "every ingestion cycle",
      "retention": "forever; files are immutable",
      "primary_key": [
        "lsn"
      ],
      "how_to_query": "SELECT * FROM read_parquet('data/lake/changes/*.parquet') WHERE table_name = 'wallets' ORDER BY lsn",
      "columns": [
        {
          "name": "lsn",
          "type": "BIGINT"
        },
        {
          "name": "table_name",
          "type": "VARCHAR"
        },
        {
          "name": "op",
          "type": "VARCHAR"
        },
        {
          "name": "pk",
          "type": "VARCHAR"
        },
        {
          "name": "before",
          "type": "VARCHAR"
        },
        {
          "name": "after",
          "type": "VARCHAR"
        },
        {
          "name": "captured_at",
          "type": "VARCHAR"
        },
        {
          "name": "batch_id",
          "type": "VARCHAR"
        },
        {
          "name": "ingested_at",
          "type": "VARCHAR"
        }
      ]
    },
